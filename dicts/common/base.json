    },
    {
      "pattern": "^Created\\s+([A-Za-z]{3}\\s+\\d{1,2},\\s+\\d{4})$",
      "replacement": "创建时间：$1"
    },
    {
      "pattern": "^Copyright ©\\s+\\d{4}\\s+Apple Inc\\. All rights reserved\\.$",
      "replacement": "版权所有 © Apple Inc. 保留所有权利。"
    },
    {
      "pattern": "Create a provisioning profile to install development apps on iOS, iPadOS, watchOS, and visionOS test devices\\.",
