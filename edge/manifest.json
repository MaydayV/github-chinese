{
  "manifest_version": 3,
  "name": "GitHub 中文汉化插件",
  "version": "2.2.5",
  "description": "GitHub 中文汉化插件用于将 GitHub 页面中的菜单、按钮、标题、提示语等界面文本进行本地化为简体中文，提升中文用户的浏览与协作效率。",
  "homepage_url": "https://star.caodan.io",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://skills.github.com/*",
    "https://gist.github.com/*",
    "https://education.github.com/*",
    "https://www.githubstatus.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GitHub 中文汉化插件",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://skills.github.com/*",
        "https://gist.github.com/*",
        "https://education.github.com/*",
        "https://www.githubstatus.com/*"
      ],
      "js": [
        "locals.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options/options.html"
}
